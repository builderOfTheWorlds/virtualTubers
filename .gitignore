*.swp

# ── Claude Code (machine-specific, keep local) ────────────────────────────────
.claude/settings.local.json

# ── Runtime / world-state (generated at runtime, not source) ──────────────────
data/
world-state/
.logs/
# Rerun Theater episode library — generated by the campaign generators
# (generators/coder/build_library.py and friends, docs/campaign_platform_build.md),
# synced to the host by hand (docs/replay_pane.md), not shipped via git.
# Exception: replays/coder/sample.json is a hand-written demo episode that
# README.md/docs/replay.md use as a smoke test (`python app/replay.py
# replays/coder/sample.json`) and must survive a fresh clone — un-ignore
# just that one file. Every other episode (including everything else under
# replays/coder/) stays ignored.
replays/*
!replays/coder/
replays/coder/*
!replays/coder/sample.json
# Piper voice models — fetched by scripts/download_voices.py, synced to the
# host by hand (docs/tts_client.md), not shipped via git
voices/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
/.env