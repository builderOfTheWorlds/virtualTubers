#!/bin/bash
# Mock `id`: pretend to be root, unless $MOCK_STATE/not_root exists.
if [[ -f "$MOCK_STATE/not_root" ]]; then
    if [[ "$1" == "-u" ]]; then echo 1000; else echo "uid=1000(user) gid=1000(user)"; fi
    exit 0
fi
if [[ "$1" == "-u" ]]; then echo 0; else echo "uid=0(root) gid=0(root)"; fi
