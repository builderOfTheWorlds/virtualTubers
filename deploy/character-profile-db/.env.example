# Stack environment for character-profile-db.
#
# In Portainer: Stacks -> Add stack -> Environment variables -> Advanced mode,
# paste these lines with real values. Never commit real values — a local copy
# named .env in this directory is gitignored.

# Superuser for the instance (the init service and admin work only).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# The application's own database and role. Pick these once: changing them
# after the first deploy creates a second role/database, it does not rename.
CHARACTER_DB_NAME=character_profile
CHARACTER_DB_USER=character_profile
CHARACTER_DB_PASSWORD=change-me-app

# Host port on 192.168.1.120. 5432 is the stack-wide virtualtubers Postgres.
CHARACTER_DB_PORT=5433

# Leave unset on mafober (defaults to the ZFS dataset scripts/install.sh
# creates). Set only for a throwaway test instance on another Docker host.
# CHARACTER_DB_DATA_DIR=/home/secus/character-profile-db-test
